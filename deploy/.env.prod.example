# ── /opt/ai_movie 专用 Postgres + Redis（勿与 kepu 共用）────────
POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm
POSTGRES_PORT=15432
REDIS_PORT=16379

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
# API 与进程内任务平台共用连接池（uvicorn 建议 --workers 1）
# 单进程最多 70 条，PG max_connections=100 时保留 30 条余量。
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
REDIS_URL=redis://127.0.0.1:16379/0

PUBLIC_BASE_URL=https://your-site.example.com
CORS_ORIGINS=https://your-site.example.com,https://admin.your-site.example.com
# 真实生产域名见本机 backend/.env.secrets.local（勿提交）
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

ARK_MOCK=false
# 开源版统一走 TokenFree New API（管理后台填写 Key；勿填 Moonshot/方舟 Key）
ARK_API_KEY=your-tokenfree-api-key

OPENAI_API_KEY=your-tokenfree-api-key
OPENAI_BASE_URL=https://www.tokenfree.com/v1
MODEL_LLM=kimi-k2.6

QUOTA_ENABLED=false

BILLING_ENABLED=true
BILLING_MARKUP=1.0
# 注册赠金默认关闭；开启后同一 IP 每天最多 2 个账号可领
BILLING_SIGNUP_GRANT_FEN=0
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
# 勿用含 /api/ 的 notify（pay.gitcc.com WAF 会拦）；nginx 将 /epay/notify 反代到后端
EPAY_NOTIFY_URL=https://www.printfilm.com/epay/notify
EPAY_RETURN_URL=https://www.printfilm.com/pricing?paid=1

# 充值通道：epay（易支付）| stripe（支付宝/微信走 Stripe Checkout）；也可在管理后台「支付设置」切换
PAYMENT_PROVIDER=epay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 收款币种，默认 cny 按套餐原价；香港账户可用 hkd 并填 STRIPE_FX_RATE（1 CNY = ? HKD）
STRIPE_CURRENCY=cny
STRIPE_FX_RATE=1.0
# 留空默认 {PUBLIC_BASE_URL}/pricing?paid=1 与 /pricing
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# 统一任务平台：全站与单用户执行槽位
TASK_RUNTIME_MAX_CONCURRENCY=4
TASK_USER_MAX_CONCURRENCY=4
